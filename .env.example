# Copy to .env for local development. In the cloud, set these as env vars.

# PostgreSQL connection. Local default shown; for Neon paste the connection
# string from the Neon console (postgresql://... — the driver prefix is
# added automatically).
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/expense_tracker

# API auth. When set, every endpoint except / and /health requires the
# X-API-Key header to equal this value. Leave unset for open local dev.
#API_KEY=change-me-to-a-long-random-string

# Allowed browser origins for the dashboard, comma-separated. * = any (dev).
#CORS_ORIGINS=https://your-dashboard.vercel.app,http://localhost:5173

# Timezone used to bucket transactions into months.
#APP_TZ=Asia/Kolkata

# Free Groq API key for AI categorization + AI SMS-parse fallback.
# Get one free (no card) at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# DB connection pool (defaults 25/50 for local bursts; use ~5/5 on free tiers).
#DB_POOL_SIZE=5
#DB_MAX_OVERFLOW=5
