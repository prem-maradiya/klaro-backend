# Copy to .env for local development. In the cloud, set these as env vars.

# PostgreSQL connection. Local default shown; for Neon paste the connection
# string from the Neon console (postgresql://... — the driver prefix is
# added automatically).
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/expense_tracker

# Auth (Phase 7.1+): user routes verify a Supabase JWT against the project's
# JWKS. Set the project URL so the backend can fetch the signing keys. Unset in
# unit tests (auth is overridden there).
#SUPABASE_URL=https://<project-ref>.supabase.co

# Allowed browser origins for the dashboard, comma-separated. * = any (dev).
#CORS_ORIGINS=https://your-dashboard.vercel.app,http://localhost:5173

# Timezone used to bucket transactions into months.
#APP_TZ=Asia/Kolkata

# Free Groq API key for AI categorization + AI SMS-parse fallback.
# Get one free (no card) at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# DB connection pool (defaults 25/50 for local bursts; use ~5/5 on free tiers).
#DB_POOL_SIZE=5
#DB_MAX_OVERFLOW=5

# --- Ops hardening (Phase 7.5) — all optional, sensible defaults shown ---

# Error tracking. Set the project DSN from sentry.io to turn it on; unset = off.
#SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
#SENTRY_ENVIRONMENT=production         # defaults to VERCEL_ENV or "production"
#SENTRY_TRACES_SAMPLE_RATE=0           # 0 = errors only; raise for perf tracing

# Rate limiting (on by default, keyed per authenticated user / client IP).
#RATELIMIT_ENABLED=true                # set false to disable entirely
#RATELIMIT_DEFAULT=600/minute          # global cap; clears a full import burst (~200 POSTs)
#RATELIMIT_PARSE=30/minute             # AI /parse-sms; just above the app's 25/import cap
# In-memory by default (per warm instance). For shared limits across serverless
# instances point this at Redis, e.g. an Upstash free DB:
#RATELIMIT_STORAGE_URI=redis://default:<pwd>@<host>:<port>
